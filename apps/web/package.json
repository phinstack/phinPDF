{
  "name": "@phinpdf/web",
  "version": "0.0.0",
  "private": true,
  "description": "phinPDF web app (also the UI of the desktop app).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@phinpdf/core": "workspace:*",
    "@phinpdf/editor": "workspace:*",
    "@phinpdf/platform": "workspace:*",
    "@phinpdf/renderer": "workspace:*",
    "@phinpdf/ui": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3"
  }
}
