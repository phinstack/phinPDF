{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phinPDF",
  "mainBinaryName": "phinpdf",
  "version": "0.0.0",
  "identifier": "org.phinpdf.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @phinpdf/web dev",
    "beforeBuildCommand": "pnpm --filter @phinpdf/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "phinPDF",
        "width": 1100,
        "height": 850,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright 2026 The phinPDF Authors",
    "category": "Productivity",
    "shortDescription": "Free, open-source PDF viewer and editor",
    "publisher": "phinPDF",
    "homepage": "https://github.com/phinstack/phinPDF",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": { "desktopTemplate": "linux.desktop.hbs" },
      "rpm": { "desktopTemplate": "linux.desktop.hbs" }
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
